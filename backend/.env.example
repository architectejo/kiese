# ─────────────────────────────────────────────────────────────────────────
# Modèle de configuration backend ETS. KIESE.
# Copier ce fichier en ".env" (même dossier) et renseigner de vraies valeurs.
# Ne JAMAIS committer le fichier ".env" réel (voir .gitignore).
#
# ATTENTION (BUG-007) : si un dossier nommé ".env" existe déjà à côté de ce
# fichier, c'est très probablement l'environnement virtuel Python Windows de
# l'archive d'origine (il contient Lib/, Scripts/, pyvenv.cfg), PAS un fichier
# de configuration. Django lit ".env" comme un fichier texte
# (voir kiese/settings.py::load_dotenv) : les deux usages sont incompatibles.
#   1. Renommer le dossier venv existant en ".venv"      (git bash : `mv .env .venv`)
#   2. Recréer un venv propre si besoin : `python -m venv .venv`
#   3. Copier ce fichier ".env.example" en ".env" (fichier texte, pas dossier)
#      et renseigner les valeurs réelles.
# ─────────────────────────────────────────────────────────────────────────

# Clé secrète Django. Générer une vraie valeur aléatoire et longue, par ex. :
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
# Ne jamais réutiliser la clé de développement codée en dur dans settings.py,
# ni une clé déjà utilisée/exposée ailleurs (voir rapport nettoyeur-securite
# au sujet de .env.production).
DJANGO_SECRET_KEY=change-me-generate-a-real-random-secret-key

# "True" en développement local uniquement. Doit être "False" (ou absent) en
# production — c'est la valeur par défaut si la variable n'est pas définie.
DJANGO_DEBUG=True

# Liste séparée par des virgules, sans espaces, des noms d'hôte autorisés à
# servir ce backend (Django HttpRequest.get_host()).
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Origines autorisées pour les requêtes CORS depuis le frontend (séparées par
# des virgules, sans espace, avec le schéma http/https).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ─── Base de données ────────────────────────────────────────────────────
# Laisser vide (ou absent) pour utiliser SQLite en développement local.
# En production, utiliser PostgreSQL :
#   DB_ENGINE=django.db.backends.postgresql
DB_ENGINE=
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=

# ─── JWT / sécurité (BUG-006) ───────────────────────────────────────────
# Durée de vie du token d'accès, en minutes (par défaut 30 si absent).
DJANGO_JWT_ACCESS_MINUTES=30

# Limite de tentatives de connexion sur /api/core/auth/login/, PAR COMPTE
# VISÉ (BUG-087 : plus par IP seule — voir core/throttling.py), format
# "<nombre>/<période>", ex. "5/min".
DJANGO_LOGIN_THROTTLE_RATE=5/min

# Garde-fou complémentaire PAR IP (plus large), anti credential-stuffing /
# énumération de comptes depuis une même source (BUG-087).
DJANGO_LOGIN_IP_THROTTLE_RATE=30/min

# ─── HTTPS / proxy (BUG-005, actif uniquement si DJANGO_DEBUG=False) ────
# Mettre "False" seulement si la terminaison TLS et la redirection HTTPS sont
# déjà gérées entièrement par le proxy (Apache/Passenger ou Nginx) en amont.
DJANGO_SECURE_SSL_REDIRECT=True

# Durée HSTS en secondes (31536000 = 1 an). Ne l'activer pleinement que
# lorsque le HTTPS est stable sur tous les sous-domaines (etskiese.com,
# www.etskiese.com, api.etskiese.com).
DJANGO_HSTS_SECONDS=31536000
